ANTHROPIC_API_KEY_MILO=
DATABASE_URL=postgres://milo:milo@localhost:5433/milo?sslmode=disable
# The Claude model Milo runs on. Defaults to claude-haiku-5-5.
# MILO_MODEL=
# Tokens a user may spend with Milo in a day. Defaults to 3000000.
# MILO_DAILY_TOKEN_CAP=
# Sign-up is closed unless this is set.
MILO_INVITE_CODE=
# Your Apple team ID, for `make phone` (Xcode, Signing & Capabilities, Team).
MILO_TEAM_ID=
